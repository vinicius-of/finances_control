{
    "compilerOptions": {
      "target": "ES2022",
      "module": "ESNext",
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "strict": true,
      "skipLibCheck": true,
      "outDir": "./dist",
      "rootDir": "./src",
      "paths": {
        "@interfaces/*": ["./src/interfaces/*"],
        "@controllers/*": ["./src/controllers/*"],
        "@services/*": ["./src/services/*"],
        "@enums/*": ["./src/enums/*"],
        "@dtos/*": ["./src/dtos/*"]
      }
    },
    "exclude": ["node_modules", "dist"],
    "$schema": "https://json.schemastore.org/tsconfig"
  }